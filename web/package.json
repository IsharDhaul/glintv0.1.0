{
  "name": "glint-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:types": "openapi-typescript ../contracts/openapi.json -o src/lib/api/types.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "lz-string": "1.5.0",
    "next": "^16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "msw": "3.0.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
